# Copy this file to .env.preview for compose.preview.yaml.
# Replace with a random secret, for example the output of: openssl rand -hex 32
# Retain an existing repository's secret if its bearer tokens must stay valid.
NOTE_SYNC_SECRET=replace-with-random-secret

# Separate preview host binding; production on port 5500 is unaffected.
NOTEDOWN_PREVIEW_BIND_ADDRESS=0.0.0.0
NOTEDOWN_PREVIEW_PORT=5501
NOTE_SYNC_CORS_ORIGIN=*
# Enable only when serving through HTTPS.
NOTE_SYNC_SECURE_COOKIES=false
# Set to the public origin for browser session writes behind an HTTPS proxy.
# NOTE_SYNC_PUBLIC_ORIGIN=https://notes.example.com

# Local process settings. Preview Compose overrides storage/auth paths to /data.
NOTE_SYNC_STORAGE=storage
# NOTE_SYNC_AUTH_FILE=storage/auth.json
# Optional local environment account. Omit to use /setup and auth.json.
# Preview Compose does not pass these account variables by default.
# NOTE_SYNC_USERNAME=
# NOTE_SYNC_PASSWORD=
# NOTE_SYNC_PASSWORD_HASH=

# Reverse proxy deployments must explicitly pass FORWARDED_ALLOW_IPS into
# Uvicorn's container environment, limited to the actual trusted proxy IP/network.
# This variable is not forwarded by compose.preview.yaml by default.
